                "summary": "Register a new user",
                "operationId": "c7bb21a0d87049e161b8e4c9b0d909f2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Admin"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "admin@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "admin"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login and receive API token",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "admin@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful"
                    }
                }
            }
        },
        "/api/programmes/{programme}/courses": {
            "get": {
                "tags": [
                    "Courses"
                ],
                "summary": "List all courses in a programme",
                "operationId": "dc6d869542cceef4a5c992e65bd9cbe5",
                "parameters": [
                    {
                        "name": "programme",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of courses"
                    }
                }
            },
            "post": {
                "tags": [
                    "Courses"
                ],
                "summary": "Create a new course in a programme",
                "operationId": "f57136ba645cf90c38161bada0d33417",
                "parameters": [
                    {
                        "name": "programme",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "CS301"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Database Systems"
                                    },
                                    "credits": {
                                        "type": "integer",
                                        "example": 4
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Course created"
                    }
                }
            }
        },
        "/api/enrollments": {
            "post": {
                "tags": [
                    "Enrollments"
                ],
                "summary": "Enroll a student in an examination course",
                "operationId": "6a2e292dcc494335970a261a2772dd66",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "student_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "examination_course_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Enrollment created"
                    }
                }
            }
        },
        "/api/examinations": {
            "get": {
                "tags": [
                    "Examinations"
                ],
                "summary": "List all examinations",
                "operationId": "8599f4a9bfb42dbfb86093c76d690cc8",
                "responses": {
                    "200": {
                        "description": "Paginated list of examinations"
                    }
                }
            },
            "post": {
                "tags": [
                    "Examinations"
                ],
                "summary": "Create a new examination",
                "operationId": "49fcde738a38309641c0d27032183ab7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "programme_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Fall 2026"
                                    },
                                    "academic_year": {
                                        "type": "string",
                                        "example": "2026-2027"
                                    },
                                    "term": {
                                        "type": "string",
                                        "example": "Fall"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Examination created"
                    }
                }
            }
        },
        "/api/examinations/{examination}": {
            "get": {
                "tags": [
                    "Examinations"
                ],
                "summary": "Show an examination with its courses and components",
                "operationId": "a4b41b2505097eddd0c2ab700792df5c",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Examination details"
                    }
                }
            }
        },
        "/api/examinations/{examination}/status": {
            "patch": {
                "tags": [
                    "Examinations"
                ],
                "summary": "Update the examination lifecycle status",
                "operationId": "669d66608b8ff2ba643d43c010574d11",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "draft",
                                            "open",
                                            "locked",
                                            "computing",
                                            "published"
                                        ],
                                        "example": "open"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status updated"
                    }
                }
            }
        },
        "/api/examinations/{examination}/courses": {
            "post": {
                "tags": [
                    "Examinations"
                ],
                "summary": "Attach a course to an examination",
                "operationId": "25a2962fad65e24dc4feb0de4535379f",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "course_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "max_marks": {
                                        "type": "integer",
                                        "example": 100
                                    },
                                    "pass_marks": {
                                        "type": "integer",
                                        "example": 40
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Course attached to examination"
                    }
                }
            }
        },
        "/api/marks": {
            "post": {
                "tags": [
                    "Marks"
                ],
                "summary": "Submit or correct a single mark",
                "operationId": "c0ceaec9b5b2cc6c43e4055746aa3ca5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "roll_number": {
                                        "type": "string",
                                        "example": "CSE2026001"
                                    },
                                    "course_code": {
                                        "type": "string",
                                        "example": "CS301"
                                    },
                                    "component_name": {
                                        "type": "string",
                                        "example": "Internal"
                                    },
                                    "marks_obtained": {
                                        "type": "number",
                                        "example": 28.5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Mark saved and recomputation triggered"
                    }
                }
            }
        },
        "/api/examinations/{examination}/marks/upload": {
            "post": {
                "tags": [
                    "Marks"
                ],
                "summary": "Bulk upload marks via CSV",
                "operationId": "45487cfd94f444af144d134390a11682",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Batch job queued"
                    }
                }
            }
        },
        "/api/mark-uploads/{batch}": {
            "get": {
                "tags": [
                    "Marks"
                ],
                "summary": "Check status of a bulk upload batch",
                "operationId": "9fb6a74d8508460d59c048f71d91f3d4",
                "parameters": [
                    {
                        "name": "batch",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Batch status"
                    }
                }
            }
        },
        "/api/mark-uploads/{batch}/errors": {
            "get": {
                "tags": [
                    "Marks"
                ],
                "summary": "Get paginated row-level import errors for a batch",
                "operationId": "f04d3566f062f0cd8dd1cbd0122f2f4e",
                "parameters": [
                    {
                        "name": "batch",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of row-level errors"
                    }
                }
            }
        },
