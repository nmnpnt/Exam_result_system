{
    "openapi": "3.0.0",
    "info": {
        "title": "Exam Result System API",
        "description": "API documentation for the high-performance Exam Result System.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local API Server"
        }
    ],
    "paths": {
        "/api/examination-courses/{examinationCourse}/components": {
            "get": {
                "tags": [
                    "Assessment Components"
                ],
                "summary": "List all assessment components for an examination course",
                "operationId": "30fcceba604a79068b540a1f9f95ace5",
                "parameters": [
                    {
                        "name": "examinationCourse",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of components"
                    }
                }
            },
            "post": {
                "tags": [
                    "Assessment Components"
                ],
                "summary": "Create a new assessment component (e.g. Internal, Final)",
                "operationId": "07171882613bfd8f937b5a95dff8f6eb",
                "parameters": [
                    {
                        "name": "examinationCourse",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Internal"
                                    },
                                    "max_marks": {
                                        "type": "number",
                                        "example": 30
                                    },
                                    "weight_percentage": {
                                        "type": "number",
                                        "example": 0.5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Component created"
                    }
                }
            }
        },
        "/api/auth/register": {
