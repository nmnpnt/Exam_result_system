                "responses": {
                    "200": {
                        "description": "Programme details"
                    }
                }
            }
        },
        "/api/results": {
            "get": {
                "tags": [
                    "Results"
                ],
                "summary": "Get all computed results",
                "operationId": "a025a5d051517bf790b4dcef055e89fd",
                "responses": {
                    "200": {
                        "description": "A flat list of student results used by the Dashboard UI"
                    }
                }
            }
        },
        "/api/examinations/{examination}/results/compute": {
            "post": {
                "tags": [
                    "Results"
                ],
                "summary": "Compute all grades for an examination",
                "description": "Dispatches a fan-out queue architecture to compute grades for every student asynchronously.",
                "operationId": "9619d967fded5ab20b166ebfd1350333",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Computation jobs dispatched to the queue"
                    }
                }
            }
        },
        "/api/examinations/{examination}/results/publish": {
            "post": {
                "tags": [
                    "Results"
                ],
                "summary": "Publish computed results for an examination",
                "description": "Moves all computed results to 'published' status and makes them visible to students. Requires X-Idempotency-Key header.",
                "operationId": "38496c2c938bfd10b9ffd04ff816c5c5",
                "parameters": [
                    {
                        "name": "examination",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Results published with count"
                    }
                }
            }
        },
        "/api/enrollments/{enrollment}/result": {
            "get": {
                "tags": [
                    "Results"
                ],
                "summary": "View a single published result for an enrollment",
                "operationId": "542436886d0772475c50b30ebb6059c2",
                "parameters": [
                    {
                        "name": "enrollment",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Published result"
                    },
                    "404": {
                        "description": "Result not available or not yet published"
                    }
                }
            }
        },
