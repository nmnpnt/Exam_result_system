									"        pm.collectionVariables.set('programme_id', json.data[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/programmes", "host": ["{{base_url}}"], "path": ["programmes"] }
					}
				},
				{
					"name": "Show Programme",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/programmes/{{programme_id}}", "host": ["{{base_url}}"], "path": ["programmes", "{{programme_id}}"] }
