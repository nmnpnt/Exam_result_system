						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"open\"\n}"
						},
						"url": { "raw": "{{base_url}}/examinations/{{examination_id}}/status", "host": ["{{base_url}}"], "path": ["examinations", "{{examination_id}}", "status"] }
					}
				},
				{
					"name": "Add Course to Examination",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('exam_course_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"course_id\": {{course_id}},\n    \"max_marks\": 100,\n    \"pass_marks\": 40\n}"
						},
						"url": { "raw": "{{base_url}}/examinations/{{examination_id}}/courses", "host": ["{{base_url}}"], "path": ["examinations", "{{examination_id}}", "courses"] }
					}
				},
				{
					"name": "Add Assessment Component (Internal)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('component_internal_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Internal\",\n    \"max_marks\": 30,\n    \"weight_percentage\": 30\n}"
						},
						"url": { "raw": "{{base_url}}/examination-courses/{{exam_course_id}}/components", "host": ["{{base_url}}"], "path": ["examination-courses", "{{exam_course_id}}", "components"] }
					}
				},
				{
					"name": "Add Assessment Component (Final)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('component_final_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
