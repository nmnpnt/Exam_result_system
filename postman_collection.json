						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/examinations/{{examination_id}}", "host": ["{{base_url}}"], "path": ["examinations", "{{examination_id}}"] }
