					}
				},
				{
					"name": "List Assessment Components",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/examination-courses/{{exam_course_id}}/components", "host": ["{{base_url}}"], "path": ["examination-courses", "{{exam_course_id}}", "components"] }
					}
				}
			]
		},
		{
			"name": "3. Students & Enrollment",
			"description": "Create students, enroll them in examination courses.",
			"item": [
				{
					"name": "Create Student",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('student_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"programme_id\": {{programme_id}},\n    \"roll_number\": \"CSE2026099\",\n    \"name\": \"Demo Student\",\n    \"email\": \"demo@example.edu\",\n    \"batch_year\": 2026\n}"
						},
						"url": { "raw": "{{base_url}}/students", "host": ["{{base_url}}"], "path": ["students"] }
					}
				},
				{
					"name": "List Students",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/students", "host": ["{{base_url}}"], "path": ["students"] }
					}
				},
				{
					"name": "Show Student",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/students/{{student_id}}", "host": ["{{base_url}}"], "path": ["students", "{{student_id}}"] }
					}
				},
				{
					"name": "Enroll Student in Exam Course",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('enrollment_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"student_id\": {{student_id}},\n    \"examination_course_id\": {{exam_course_id}}\n}"
						},
						"url": { "raw": "{{base_url}}/enrollments", "host": ["{{base_url}}"], "path": ["enrollments"] }
					}
				}
			]
		},
		{
			"name": "4. Marks Entry",
			"description": "Enter marks one-by-one or upload a CSV in bulk.",
			"item": [
				{
					"name": "Single Mark Entry",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"enrollment_id\": {{enrollment_id}},\n    \"assessment_component_id\": {{component_internal_id}},\n    \"marks_obtained\": 25\n}"
						},
						"url": { "raw": "{{base_url}}/marks", "host": ["{{base_url}}"], "path": ["marks"] }
					}
				},
				{
					"name": "Single Mark Correction (optimistic lock)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"enrollment_id\": {{enrollment_id}},\n    \"assessment_component_id\": {{component_internal_id}},\n    \"marks_obtained\": 28,\n    \"expected_version\": 1\n}"
						},
						"url": { "raw": "{{base_url}}/marks", "host": ["{{base_url}}"], "path": ["marks"] }
					}
				},
				{
					"name": "Bulk CSV Upload (seeded exam)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('batch_id', json.batch_id);",
									"    console.log('Batch ID saved: ' + json.batch_id);",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate a unique idempotency key for each run.",
									"pm.collectionVariables.set('idempotency_key', 'bulk-' + Date.now());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "X-Idempotency-Key", "value": "{{idempotency_key}}" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "sample_marks.csv",
									"description": "Select the sample_marks.csv file from the project root."
								}
							]
						},
						"url": { "raw": "{{base_url}}/examinations/1/marks/upload", "host": ["{{base_url}}"], "path": ["examinations", "1", "marks", "upload"] },
						"description": "Uses examination ID 1 (created by the seeder). Change the ID if needed.\n\n**Important**: Select the `sample_marks.csv` file from the project root in the file picker."
					}
				},
				{
					"name": "Poll Upload Progress",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/mark-uploads/{{batch_id}}", "host": ["{{base_url}}"], "path": ["mark-uploads", "{{batch_id}}"] }
					}
				},
				{
					"name": "View Upload Errors",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/mark-uploads/{{batch_id}}/errors", "host": ["{{base_url}}"], "path": ["mark-uploads", "{{batch_id}}", "errors"] }
					}
				}
			]
		},
		{
			"name": "5. Results",
			"description": "Compute results, publish, and view individual results.",
			"item": [
				{
					"name": "Compute Results (async)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/examinations/1/results/compute", "host": ["{{base_url}}"], "path": ["examinations", "1", "results", "compute"] },
						"description": "Fans out CalculateStudentResult jobs for every enrollment in examination 1. Poll queue workers to complete."
					}
				},
				{
					"name": "Lock Examination (status → locked)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"locked\"\n}"
						},
						"url": { "raw": "{{base_url}}/examinations/1/status", "host": ["{{base_url}}"], "path": ["examinations", "1", "status"] }
					}
				},
				{
					"name": "Publish Results",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"pm.collectionVariables.set('publish_key', 'publish-' + Date.now());"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "X-Idempotency-Key", "value": "{{publish_key}}" }
						],
						"url": { "raw": "{{base_url}}/examinations/1/results/publish", "host": ["{{base_url}}"], "path": ["examinations", "1", "results", "publish"] },
						"description": "Publishes all computed results for examination 1."
					}
				},
				{
					"name": "View Student Result (enrollment 1)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/enrollments/1/result", "host": ["{{base_url}}"], "path": ["enrollments", "1", "result"] },
						"description": "Returns the published result for enrollment 1 (first seeded student, first course)."
					}
				},
				{
					"name": "View Student Result (enrollment 2)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Accept", "value": "application/json" }],
						"url": { "raw": "{{base_url}}/enrollments/2/result", "host": ["{{base_url}}"], "path": ["enrollments", "2", "result"] }
					}
				}
			]
		},
		{
			"name": "6. Idempotency Demo",
			"description": "Demonstrates that replaying the same request with the same idempotency key returns the original response, not a duplicate.",
			"item": [
				{
					"name": "First Upload (key = demo-idem-1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('batch_id', json.batch_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "X-Idempotency-Key", "value": "demo-idem-1" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "file", "type": "file", "src": "sample_marks.csv" }
							]
						},
						"url": { "raw": "{{base_url}}/examinations/1/marks/upload", "host": ["{{base_url}}"], "path": ["examinations", "1", "marks", "upload"] }
					}
				},
				{
					"name": "Replay Upload (same key = demo-idem-1)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "X-Idempotency-Key", "value": "demo-idem-1" }
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "file", "type": "file", "src": "sample_marks.csv" }
							]
						},
						"url": { "raw": "{{base_url}}/examinations/1/marks/upload", "host": ["{{base_url}}"], "path": ["examinations", "1", "marks", "upload"] },
						"description": "Should return the same batch_id as the first upload — the server replays the cached response."
					}
				}
			]
		}
	]
}
