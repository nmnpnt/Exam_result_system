							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"ECE\",\n    \"name\": \"B.Tech Electronics & Communication\",\n    \"duration_years\": 4\n}"
						},
						"url": { "raw": "{{base_url}}/programmes", "host": ["{{base_url}}"], "path": ["programmes"] }
