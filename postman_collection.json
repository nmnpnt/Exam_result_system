{
	"info": {
		"_postman_id": "exam-result-system-v1",
		"name": "Exam Result System API",
		"description": "University Examination & Result Processing System — complete API collection.\n\n## Quick start\n1. Run `docker compose up --build`\n2. Run `docker compose exec app php artisan db:seed`\n3. Hit **1. Auth → Login** (pre-filled with seeded admin credentials). The token is auto-saved.\n4. Walk through folders in order: Setup → Marks → Results.\n\nEvery request after Login uses the `{{token}}` variable automatically.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api" },
		{ "key": "token", "value": "" },
		{ "key": "programme_id", "value": "" },
		{ "key": "course_id", "value": "" },
		{ "key": "course2_id", "value": "" },
		{ "key": "examination_id", "value": "" },
		{ "key": "exam_course_id", "value": "" },
		{ "key": "exam_course2_id", "value": "" },
		{ "key": "component_internal_id", "value": "" },
		{ "key": "component_final_id", "value": "" },
		{ "key": "student_id", "value": "" },
		{ "key": "enrollment_id", "value": "" },
		{ "key": "batch_id", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
	},
	"item": [
		{
			"name": "1. Auth",
			"description": "Register or login to get a Sanctum bearer token. The token is auto-saved to `{{token}}`.",
			"item": [
				{
					"name": "Register Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.token);",
									"    console.log('Token saved: ' + json.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Admin User\",\n    \"email\": \"admin@exam.edu\",\n    \"password\": \"password\",\n    \"role\": \"admin\"\n}"
						},
						"url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
					}
				},
				{
					"name": "Login (use this after seeding)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('token', json.token);",
									"    console.log('Token saved: ' + json.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@exam.edu\",\n    \"password\": \"password\"\n}"
						},
						"url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
					}
				}
			]
		},
		{
			"name": "2. Setup (Programme → Course → Exam)",
			"description": "Create the academic structure. Run these in order, or skip if you've already seeded.",
