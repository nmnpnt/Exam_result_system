APP_NAME="Exam Result System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=exam_result_system
DB_USERNAME=exam_user
DB_PASSWORD=exam_password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bulk import tuning
MARKS_CSV_CHUNK_SIZE=2000
MARKS_CSV_MAX_ROWS=2000000

L5_SWAGGER_GENERATE_ALWAYS=true
